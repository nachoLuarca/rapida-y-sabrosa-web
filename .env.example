# Número de WhatsApp que recibe los pedidos: solo dígitos, con código país (Chile = 56).
# Si falta o no es válido, se usa el número del local definido en src/config/business.ts.
VITE_WHATSAPP_NUMBER=56974314602

# 'true' para demos: el pedido NO se envía al local, solo se muestra y se copia al portapapeles.
# Cualquier otro valor (o vacío) es modo normal.
VITE_DEMO=false
