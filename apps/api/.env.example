# Plantilla de apps/api/.env (ese archivo no va a git). Copia este archivo como .env y ajusta lo necesario.
# Los valores de abajo sirven tal cual con el PostgreSQL de docker-compose.yml (npm run db:up).

# Base de desarrollo y base de los tests (los tests la vacían en cada archivo: nunca apuntes a una base real).
DATABASE_URL=postgres://rys:rys@localhost:5432/rys
DATABASE_URL_TEST=postgres://rys:rys@localhost:5432/rys_test

PORT=3000
# development | test | production
NODE_ENV=development

# 'true' en demos: los pedidos se guardan y llegan al panel, pero nada se envía al WhatsApp del local.
DEMO_MODE=false
# Obligatoria si DEMO_MODE=true: contraseña de los usuarios de demo del panel (mínimo 10 caracteres).
DEMO_PASSWORD=

# Orígenes que pueden hacer mutaciones del panel (separados por coma). En la demo se agrega la IP de la red local.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

SESSION_TTL_HOURS=12
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
