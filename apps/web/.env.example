# Número de WhatsApp que recibe los pedidos: solo dígitos, con código país (Chile = 56).
# Si falta o no es válido, se usa el número del local de docs/data/business.json.
VITE_WHATSAPP_NUMBER=569XXXXXXXX

# 'true' para demos: el pedido NO se envía al local, solo se muestra y se copia al portapapeles.
# Cualquier otro valor (o vacío) es modo normal.
VITE_DEMO=false

# 'api': la carta sale de GET /api/menu y los pedidos van a POST /api/orders (en desarrollo, por el proxy de Vite).
# 'static' (o vacío): la carta del bundle y el pedido directo a WhatsApp, como la web publicada.
# npm run build:demo siempre usa 'static'.
VITE_DATA_SOURCE=static
