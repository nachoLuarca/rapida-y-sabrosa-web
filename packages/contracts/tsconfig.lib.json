{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "target": "es2023",
    /* Sin DOM ni tipos de Node: los contratos no dependen del navegador ni del servidor. */
    "lib": ["ES2023"],
    "types": [],
    "skipLibCheck": true,

    /* Imports con extensión .ts: así Node (con type stripping) y Vite pueden leer src/ sin paso de build. */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
